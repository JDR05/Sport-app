# Supabase — Werte aus dem Supabase-Dashboard (Project Settings -> API).
# Echte Werte gehoeren nach .env.local und werden nie committet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absichtlich NICHT gesetzt — siehe ADR-034. Der Secret Key umgeht RLS
# vollstaendig, und die App braucht ihn nirgends: jeder Zugriff passiert im
# Namen eines angemeldeten Nutzers. Er kommt erst dazu, wenn ein
# serverseitiger Vorgang ihn wirklich braucht, und dann bewusst.
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- AI ------
# Optional. Ohne Key laeuft die App vollstaendig: ein deterministischer
# Klassifikator ordnet das Ziel ein und die Archetypen planen wie gewohnt.
# Key anlegen unter https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=

# Modelle pro Aufgabe getrennt konfigurierbar. Voreinstellung claude-opus-5.
#
# Guenstigere Alternative: claude-sonnet-5. Beide Aufrufe setzen
# output_config.effort, und das akzeptiert nicht jedes Modell.
#
# NICHT claude-haiku-4-5: Haiku 4.5 lehnt effort mit einem 400 ab. Der Aufruf
# wuerde also bei jedem Versuch scheitern, die App faellt still auf den
# deterministischen Pfad zurueck — und niemand merkt, dass die KI nie laeuft.
# Genau das stand hier vorher als Spartipp.
AI_CLASSIFY_MODEL=claude-opus-5
AI_PROPOSE_MODEL=claude-opus-5

# ----------------------------------------------------------- Gratis-Weg ----
#
# Jeder Anbieter, der die OpenAI-kompatible /chat/completions-Schnittstelle
# spricht. Genau deshalb ist es so gebaut: welcher Anbieter gerade ein Free
# Tier hat, aendert sich staendig — hier sind es drei Variablen statt Code.
#
# Geprueft im September 2026 (Limits aendern sich haeufig, vorher nachsehen):
#   Google AI Studio  https://generativelanguage.googleapis.com/v1beta/openai
#                     Gemini Flash, ~1500 Anfragen/Tag, keine Karte noetig
#   Groq              https://api.groq.com/openai/v1
#                     llama-3.3-70b-versatile, 30/min, 1000/Tag
#   OpenRouter        https://openrouter.ai/api/v1
#                     50 Gratis-Anfragen/Tag unter 10 $ Guthaben
#   Mistral           https://api.mistral.ai/v1
#   Cerebras          https://api.cerebras.ai/v1
#
# WICHTIG, bevor du das anschaltest: Gratis-Stufen finanzieren sich in aller
# Regel damit, dass deine Eingaben zum Training verwendet werden. Diese App
# schickt dabei das Ziel im Klartext und ein grobes Profil (Schlaf frueh/spaet,
# kocht selten/oft, Bildschirmzeit wenig/viel). Exakte Zeiten und Zahlen
# bleiben in der Datenbank — siehe proposeUserMessage in src/lib/ai/tasks.ts.
# Trotzdem sind es Gesundheitsdaten. Wenn dir das zu weit geht: Variablen leer
# lassen, dann laeuft alles deterministisch weiter.
AI_COMPAT_BASE_URL=
AI_COMPAT_KEY=
AI_COMPAT_MODEL=
# Optional: ein kleineres Modell nur fuers Einordnen des Ziels.
AI_COMPAT_CLASSIFY_MODEL=
# Optional, nur fuer Logs: welcher Anbieter geantwortet hat.
AI_COMPAT_LABEL=

# Millisekunden. Danach uebernimmt der deterministische Pfad.
AI_TIMEOUT_MS=20000

# 'mock' erzwingt den deterministischen Adapter, 'null' schaltet AI ganz ab,
# 'compat' erzwingt den Gratis-Anbieter auch dann, wenn ein Claude-Key da ist.
# Leer lassen fuer das normale Verhalten: Claude wenn ein Key da ist, sonst der
# kompatible Anbieter wenn konfiguriert, sonst deterministisch.
AI_ADAPTER=
