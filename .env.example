# Supabase — Werte aus dem Supabase-Dashboard (Project Settings -> API).
# Echte Werte gehoeren nach .env.local und werden nie committet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur serverseitig verwenden, niemals im Browser-Bundle.
SUPABASE_SECRET_KEY=

# AI-Layer. Bis Schritt 7 laeuft ein deterministischer Mock-Adapter,
# solange kein Key gesetzt ist.
ANTHROPIC_API_KEY=
