# Supabase — Werte aus dem Supabase-Dashboard (Project Settings -> API).
# Echte Werte gehoeren nach .env.local und werden nie committet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absichtlich NICHT gesetzt — siehe ADR-034. Der Secret Key umgeht RLS
# vollstaendig, und die App braucht ihn nirgends: jeder Zugriff passiert im
# Namen eines angemeldeten Nutzers. Er kommt erst dazu, wenn ein
# serverseitiger Vorgang ihn wirklich braucht, und dann bewusst.
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- AI ------
# Optional. Ohne Key laeuft die App vollstaendig: ein deterministischer
# Klassifikator ordnet das Ziel ein und die Archetypen planen wie gewohnt.
# Key anlegen unter https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=

# Modelle pro Aufgabe getrennt konfigurierbar. Voreinstellung claude-opus-5.
# Guenstigere Alternativen: claude-sonnet-5, claude-haiku-4-5.
# Die Zieleinordnung ist eine kleine Aufgabe und laeuft auch auf Haiku gut;
# bei den Vorschlaegen zeigt sich die Modellqualitaet.
AI_CLASSIFY_MODEL=claude-opus-5
AI_PROPOSE_MODEL=claude-opus-5

# Millisekunden. Danach uebernimmt der deterministische Pfad.
AI_TIMEOUT_MS=20000

# 'mock' erzwingt den deterministischen Adapter, 'null' schaltet AI ganz ab.
# Leer lassen fuer das normale Verhalten (Claude, wenn ein Key da ist).
AI_ADAPTER=
